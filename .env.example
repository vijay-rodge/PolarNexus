# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL / fallback SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polar_science
SQLITE_FALLBACK_URL=sqlite:///./data/polar_science.db

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/vectorstore/chroma
CHROMA_COLLECTION_NAME=polar_science_knowledge_base

# Embedding Provider
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# DSpace Repository Endpoint
DSPACE_BASE_URL=http://14.139.119.23:8080/dspace

# FastAPI Server
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit Server
STREAMLIT_PORT=8501
